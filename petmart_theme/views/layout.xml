<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Icon + pet illustration set (inline SVG, no external files) ===== -->
    <template id="icon" name="PETSMART icon">
        <svg t-if="name == 'paw'" class="pm-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5.5" cy="11" r="2"/><circle cx="9.5" cy="6.5" r="2"/><circle cx="14.5" cy="6.5" r="2"/><circle cx="18.5" cy="11" r="2"/><path d="M12 12c-3 0-5.5 3.5-5.5 5.5 0 1.5 1.5 2.5 3 2 1-.4 1.5-.6 2.5-.6s1.5.2 2.5.6c1.5.5 3-.5 3-2C17.5 15.5 15 12 12 12z"/></svg>
        <svg t-elif="name == 'search'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4-4"/></svg>
        <svg t-elif="name == 'user'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        <svg t-elif="name == 'help'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 015 0c0 1.5-2.5 2-2.5 3.5M12 17v.01"/></svg>
        <svg t-elif="name == 'cart'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2 11h11l2-8H6"/><circle cx="9" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>
        <svg t-elif="name == 'truck'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="6" width="12.5" height="10" rx="1"/><path d="M14 9h4l3 3v4h-7"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
        <svg t-elif="name == 'headset'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0116 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>
        <svg t-elif="name == 'refresh'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 10-2.5 5.8M20 5v5h-5"/></svg>
        <svg t-elif="name == 'clipboard'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2.5h6V6H9zM9 13l2 2 4-4"/></svg>
        <svg t-elif="name == 'lock'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
        <svg t-elif="name == 'bag'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h12l1 4v11a2 2 0 01-2 2H7a2 2 0 01-2-2V8z"/><path d="M9.5 14l2 2 3.5-4"/></svg>
        <svg t-elif="name == 'bone'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 16l8-8"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="17.5" cy="6.5" r="2"/><circle cx="5" cy="14.5" r="1.4"/><circle cx="19" cy="9.5" r="1.4"/></svg>
        <svg t-elif="name == 'can'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6c0-1.5 3-3 7-3s7 1.5 7 3v12c0 1.5-3 3-7 3s-7-1.5-7-3z"/><path d="M5 6c0 1.5 3 3 7 3s7-1.5 7-3"/></svg>
        <svg t-elif="name == 'litter'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="18" height="11" rx="2"/><path d="M7 9V6h10v3M9 14.5h6"/></svg>
        <svg t-elif="name == 'scissors'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8 8l12 10M8 16L20 6"/></svg>
        <svg t-elif="name == 'percent'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/><path d="M19 5L5 19"/></svg>
        <svg t-elif="name == 'pill'" class="pm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="8.5" width="19" height="7" rx="3.5" transform="rotate(-40 12 12)"/><path d="M8.5 8.5l7 7"/></svg>
    </template>

    <template id="pet_face" name="PETSMART pet illustration">
        <svg class="pm-pet" viewBox="0 0 64 64" aria-hidden="true">
            <g t-if="pet == 'dog'" fill="#0f2352">
                <ellipse cx="12" cy="24" rx="8" ry="14" transform="rotate(18 12 24)"/>
                <ellipse cx="52" cy="24" rx="8" ry="14" transform="rotate(-18 52 24)"/>
                <circle cx="32" cy="34" r="21"/>
                <circle cx="24" cy="30" r="3" fill="#fff"/><circle cx="40" cy="30" r="3" fill="#fff"/>
                <ellipse cx="32" cy="41" rx="6" ry="4.5" fill="#fff"/>
            </g>
            <g t-elif="pet == 'cat'" fill="#0f2352">
                <path d="M9 30L11 6l16 11zM55 30L53 6 37 17z"/>
                <circle cx="32" cy="36" r="21"/>
                <path d="M20 31l7 3-7 3zM44 31l-7 3 7 3z" fill="#fff"/>
                <path d="M29 42h6l-3 3z" fill="#fff"/>
            </g>
            <g t-elif="pet == 'bird'" fill="#0f2352">
                <ellipse cx="30" cy="38" rx="20" ry="16"/>
                <circle cx="44" cy="24" r="10"/>
                <path d="M52 22l10 4-10 4z" fill="#ff7a45"/>
                <circle cx="46" cy="22" r="2.2" fill="#fff"/>
                <path d="M10 40L2 50l16-4z"/>
            </g>
            <g t-elif="pet == 'fish'" fill="#0f2352">
                <ellipse cx="28" cy="32" rx="22" ry="13"/>
                <path d="M46 32l16-12v24z"/>
                <circle cx="17" cy="29" r="2.4" fill="#fff"/>
            </g>
            <g t-elif="pet == 'small'" fill="#0f2352">
                <circle cx="14" cy="16" r="9"/><circle cx="50" cy="16" r="9"/>
                <circle cx="32" cy="36" r="21"/>
                <circle cx="24" cy="32" r="3" fill="#fff"/><circle cx="40" cy="32" r="3" fill="#fff"/>
                <ellipse cx="32" cy="42" rx="4" ry="3" fill="#fff"/>
            </g>
            <g t-elif="pet == 'reptile'" fill="#0f2352">
                <path d="M6 44c0-14 12-24 28-24 10 0 18 4 24 10-6-1-9 2-12 5 6 2 10 6 12 12-8-2-12 0-16 4-10 0-20-2-28-7z"/>
                <circle cx="46" cy="28" r="2.2" fill="#fff"/>
            </g>
        </svg>
    </template>

    <!-- Font (a <link>, not an SCSS @import: Odoo splits @import URLs on ";") -->
    <template id="fonts" inherit_id="website.layout" name="PETSMART font" priority="99">
        <xpath expr="//head" position="inside">
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&amp;display=swap"/>
        </xpath>
    </template>

    <!-- ===== Header ===== -->
    <template id="header" inherit_id="website.template_header_default" name="PETSMART header" priority="99">
        <xpath expr="//t[@t-call='website.navbar']" position="replace">
            <div class="pm-header">
                <div class="pm-header__top">
                    <div class="container pm-header__row">
                        <a href="/" class="pm-logo" aria-label="PETSMART Nigeria">
                            <span class="pm-logo__mark"><t t-call="petmart_theme.icon" name.f="paw"/></span>
                            <span class="pm-logo__text"><strong>PETSMART<sup>®</sup></strong><small>NIGERIA</small></span>
                        </a>
                        <form class="pm-search" action="/shop" method="get" role="search">
                            <input type="search" name="search" t-att-value="search" placeholder="Search products, brands, categories…" aria-label="Search"/>
                            <button type="submit" aria-label="Search"><t t-call="petmart_theme.icon" name.f="search"/></button>
                        </form>
                        <div class="pm-header__actions">
                            <t t-if="request.env.user._is_public()">
                                <a href="/web/login" class="pm-action">
                                    <t t-call="petmart_theme.icon" name.f="user"/>
                                    <span><small>Business</small><b>Sign in</b></span>
                                </a>
                            </t>
                            <t t-else="">
                                <a href="/my" class="pm-action">
                                    <t t-call="petmart_theme.icon" name.f="user"/>
                                    <span><small>Business</small><b>Account</b></span>
                                </a>
                                <a href="/web/session/logout?redirect=/" class="pm-action pm-action--quiet">
                                    <span><b>Sign out</b></span>
                                </a>
                            </t>
                            <a href="/contactus" class="pm-action pm-action--quiet d-none d-md-flex">
                                <t t-call="petmart_theme.icon" name.f="help"/><span><b>Help</b></span>
                            </a>
                            <a href="/shop/cart" class="pm-action pm-cart">
                                <t t-call="petmart_theme.icon" name.f="cart"/>
                                <sup class="my_cart_quantity" t-out="website_sale_order and website_sale_order.cart_quantity or 0"/>
                                <span><b>Cart</b></span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="pm-header__nav">
                    <div class="container pm-header__row">
                        <ul class="pm-nav">
                            <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_dog').sudo())">Dog</a></li>
                            <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_cat').sudo())">Cat</a></li>
                            <li><a href="/shop">Other Animals</a></li>
                            <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_pharmacy').sudo())">Pharmacy</a></li>
                            <li><a href="/contactus">Services</a></li>
                            <li><a href="/shop">Brands</a></li>
                            <li><a href="/shop?order=create_date+desc">New Arrivals</a></li>
                            <li><a href="/shop?order=create_date+desc" class="pm-nav__deals">Deals</a></li>
                        </ul>
                        <a href="/wholesale/pending" class="pm-pill"><t t-call="petmart_theme.icon" name.f="paw"/> Wholesale</a>
                    </div>
                </div>
                <div class="pm-header__promo">
                    <t t-call="petmart_theme.icon" name.f="truck"/>
                    Free nationwide delivery on qualifying wholesale orders over ₦150,000
                </div>
            </div>
        </xpath>
    </template>

    <!-- ===== Footer ===== -->
    <template id="footer" inherit_id="website.layout" name="PETSMART footer" priority="99">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="pm-footer" t-if="not no_footer" t-ignore="true">
                <div class="container">
                    <div class="pm-footer__bar">
                        <span>Our experts are available 24/7</span>
                        <span class="pm-footer__bar-right">
                            <b>0700-PET-SHOP</b>
                            <a href="/contactus">Chat now</a>
                            <a href="#wrapwrap" class="pm-backtop" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">↑ Back to Top</a>
                        </span>
                    </div>
                    <div class="pm-footer__grid">
                        <div>
                            <a href="/" class="pm-logo pm-logo--footer">
                                <span class="pm-logo__mark"><t t-call="petmart_theme.icon" name.f="paw"/></span>
                                <span class="pm-logo__text"><strong>PETSMART</strong><small>NIGERIA</small></span>
                            </a>
                            <p class="pm-footer__tag">Everything Your Pet Business Needs.</p>
                        </div>
                        <div>
                            <h6>Shop</h6>
                            <ul>
                                <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_dog').sudo())">Dog</a></li>
                                <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_cat').sudo())">Cat</a></li>
                                <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_bird').sudo())">Bird</a></li>
                                <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_fish').sudo())">Fish</a></li>
                                <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_small_pet').sudo())">Small Animals</a></li>
                                <li><a t-att-href="'/shop/category/%s' % slug(request.env.ref('petmart_theme.cat_grooming').sudo())">Grooming</a></li>
                            </ul>
                        </div>
                        <div>
                            <h6>Business</h6>
                            <ul>
                                <li><a href="/shop">Wholesale</a></li>
                                <li><a href="/web/signup">Open Wholesale Account</a></li>
                                <li><a href="/contactus">Bulk Orders</a></li>
                                <li><a href="/shop/cart">Reorder</a></li>
                                <li><a href="/my/orders">Order Tracking</a></li>
                            </ul>
                        </div>
                        <div>
                            <h6>Support</h6>
                            <ul>
                                <li><a href="/contactus">Help Center</a></li>
                                <li><a href="/contactus">Contact Us</a></li>
                                <li><a href="/contactus">Delivery</a></li>
                                <li><a href="/contactus">Returns</a></li>
                                <li><a href="/contactus">FAQs</a></li>
                            </ul>
                        </div>
                        <div>
                            <h6>Company</h6>
                            <ul>
                                <li><a href="/contactus">About PETSMART</a></li>
                                <li><a href="/shop">Brands</a></li>
                                <li><a href="/contactus">Careers</a></li>
                                <li><a href="/contactus">Contact</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="pm-footer__legal">
                        <span>© 2026 PETSMART NIGERIA. All rights reserved.</span>
                        <span><a href="/shop/payment">Secure Checkout</a> · Nationwide Delivery · <a href="/privacy">Terms · Privacy · Returns</a></span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
