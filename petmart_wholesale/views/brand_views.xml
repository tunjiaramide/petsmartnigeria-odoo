<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petmart_brand_view_list" model="ir.ui.view">
        <field name="name">petmart.brand.list</field>
        <field name="model">petmart.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1">
                <field name="name"/>
                <field name="product_count" string="Products"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="petmart_brand_view_search" model="ir.ui.view">
        <field name="name">petmart.brand.search</field>
        <field name="model">petmart.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="petmart_brand_action" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">petmart.brand</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a brand</p>
            <p>Brands appear in the Brand pick-list on the product form and on the website next to the product name.</p>
        </field>
    </record>

    <menuitem id="menu_petmart_brands" name="Brands" parent="website_sale.menu_catalog" action="petmart_brand_action" sequence="25"/>

</odoo>
