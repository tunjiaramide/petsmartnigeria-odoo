<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shop tile: brand line above the availability badges (same order as the homepage cards) -->
    <template id="products_item_brand" inherit_id="website_sale.products_item" name="PETSMART shop tile brand" priority="20">
        <xpath expr="//h2[hasclass('o_wsale_products_item_title')]" position="before">
            <small t-if="product.petmart_brand" class="pm-card__brand d-block" t-out="product.petmart_brand"/>
        </xpath>
    </template>

    <!-- Product page: brand above the name, availability badges under it. Never prints a quantity. -->
    <template id="product_title_petmart" inherit_id="website_sale.product_title" name="PETSMART product title" priority="20">
        <xpath expr="//h1" position="before">
            <small t-if="product.petmart_brand" class="pm-card__brand pm-product__brand d-block" t-out="product.petmart_brand"/>
        </xpath>
        <xpath expr="//h1" position="after">
            <div class="pm-badges pm-product__badges">
                <t t-call="petmart_wholesale.stock_badge">
                    <t t-set="product" t-value="product"/>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Product page: long description as dropdowns, full width under the photo and buy box
         (filled in the product form, "Product details" tab). The short description stays beside the photo. -->
    <template id="product_details_sections" inherit_id="website_sale.product" name="PETSMART product detail dropdowns" priority="20">
        <xpath expr="//div[@id='product_full_description']" position="before">
            <t t-set="pm_sections" t-value="product._petmart_website_sections()"/>
            <section t-if="pm_sections" class="pm-details container mb-5">
                <div class="accordion accordion-flush" id="pm_details_accordion">
                    <div t-foreach="pm_sections" t-as="section" class="accordion-item">
                        <h2 class="accordion-header" t-attf-id="pm_details_head_{{section.id}}">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    t-attf-data-bs-target="#pm_details_body_{{section.id}}" aria-expanded="false"
                                    t-attf-aria-controls="pm_details_body_{{section.id}}" t-out="section.name"/>
                        </h2>
                        <div t-attf-id="pm_details_body_{{section.id}}" class="accordion-collapse collapse"
                             t-attf-aria-labelledby="pm_details_head_{{section.id}}">
                            <div class="accordion-body" t-out="section.content"/>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

</odoo>
