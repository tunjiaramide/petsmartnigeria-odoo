<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Two ready-made staff roles, chosen on the user form under "PETSMART".
         Each one bundles the standard Odoo rights that job needs, so nobody has to tick them one by one.
         Uploader < Editor < Administrator (Sales Administrators and Odoo administrators get Editor rights). -->
    <record id="module_category_petsmart" model="ir.module.category">
        <field name="name">PETSMART</field>
        <field name="sequence">1</field>
    </record>

    <record id="res_groups_privilege_petsmart" model="res.groups.privilege">
        <field name="name">Store role</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_petsmart"/>
    </record>

    <record id="group_petmart_uploader" model="res.groups">
        <field name="name">Uploader</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_petsmart"/>
        <field name="comment">Manages the catalogue: creates, edits, publishes and deletes products and shop categories, uploads pictures, sets wholesale prices and stock quantities, and can see all orders. Cannot approve wholesale accounts or change settings.</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('product.group_product_manager')),
            (4, ref('stock.group_stock_user')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('website.group_website_restricted_editor')),
        ]"/>
    </record>

    <record id="group_petmart_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_petsmart"/>
        <field name="comment">Everything an Uploader can do, plus approving or rejecting wholesale account registrations and editing customer contacts.</field>
        <field name="implied_ids" eval="[
            (4, ref('group_petmart_uploader')),
            (4, ref('base.group_partner_manager')),
        ]"/>
    </record>

    <!-- Sales Administrators could approve accounts before these roles existed: they keep that right -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_petmart_editor'))]"/>
    </record>

</odoo>
